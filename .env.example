# Public browser-facing Keycloak realm and Rule callback.
PORTAL_URL=https://10.125.5.179
OIDC_ISSUER=https://10.125.5.179/auth/realms/remittance
OIDC_REDIRECT_URI=https://10.125.5.179/rule/callback
OIDC_CLIENT_ID=rule
OIDC_CLIENT_SECRET=replace-with-keycloak-client-secret
OIDC_TOKEN_AUDIENCE=rule
SESSION_SECRET=replace-with-random-secret-at-least-32-characters

# Internal server-to-server endpoints; Podman must join remit-shared.
OIDC_ALLOW_HTTP=true
OIDC_TOKEN_ENDPOINT=http://keycloak:8080/auth/realms/remittance/protocol/openid-connect/token
OIDC_JWKS_URI=http://keycloak:8080/auth/realms/remittance/protocol/openid-connect/certs
OIDC_USERINFO_ENDPOINT=http://keycloak:8080/auth/realms/remittance/protocol/openid-connect/userinfo
OIDC_LOGOUT_ENDPOINT=/protocol/openid-connect/logout

# Treasury backend reached by the server, not the browser.
RULE_API_URL=http://10.125.5.177:8080
RULE_API_PREFIX=/api/v1/
NODE_OPTIONS=--max-http-header-size=32768
NODE_TLS_REJECT_UNAUTHORIZED=1
